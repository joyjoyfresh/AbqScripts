# Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# Python 虚拟环境
.env/
.venv/
venv/

# 编辑器/IDE 临时文件
.idea/
.vscode/
*.swp
*.swo

.workbuddy/

# 测试目录默认忽略，仅显式纳入纯Python回归入口
test/
!test/
test/*
!test/ML/
test/ML/*
!test/ML/test_complex_frf_pipeline.py

# 正式工作目录下的所有文件不进版本库
Run/*
!Run/evaluation/
Run/evaluation/*
!Run/evaluation/*.py
!Run/Auto_ch*/
Run/Auto_ch*/*
!Run/Auto_ch*/*.py
